        "vysledek": "The building operated without a single day of vacancy throughout the entire project. The new units with heat recovery reduced HVAC energy consumption, and tenants are holding comfortable temperatures even in August for the first time in years."
      },
      "poliklinika-pisek": {
        "nazev": "Air Conditioning and Ventilation for a Polyclinic in Písek",
        "misto": "Písek",
        "perex": "Examination rooms, waiting areas, and a laboratory. Each space had different requirements for air purity and noise levels — and none of them could be heard.",
        "zadani": "The healthcare facility needed to address summer overheating in the examination rooms and ensure hygienically adequate air exchange in the sampling rooms.",
        "rozsah": {
          "r1": "HVAC and cooling design including hygiene requirements",
          "r2": "Installation of multisplit systems in examination rooms with emphasis on low noise levels",
          "r3": "Mechanical ventilation of sampling and laboratory rooms",
          "r4": "Filtration and indoor environment quality measurement",
          "r5": "Staff training and maintenance plan setup"
        },
        "technologie": {
          "t1": "VRF system",
          "t2": "Mechanical ventilation",
          "t3": "Air filtration",
          "t4": "CO₂ measurement"
        },
        "vysledek": "The examination rooms maintain the set temperature even during hot summer days, noise in the waiting areas remained below the limit, and the polyclinic has documented indoor environment quality measurements."
      },
      "vyrobni-hala-milevsko": {
        "nazev": "Cooling and ventilation of a production hall in Milevsko",
        "misto": "Milevsko",
        "perex": "A press shop where temperatures near the machines exceeded 38 °C in summer. The solution had to handle both process heat and exhaust extraction.",
        "zadani": "The manufacturer needed to reduce temperatures at workstations near the presses and remove heat and vapors from the process without blowing out the heated air from the entire hall.",
        "rozsah": {
          "r1": "Heat load calculation from process equipment and concept design",
          "r2": "Supply and installation of HVAC equipment with heat recovery",
          "r3": "Local exhaust ventilation at press stations",
          "r4": "Adiabatic cooling of supply air",
          "r5": "Control based on temperature and shift occupancy"
        },
        "technologie": {
          "t1": "Industrial HVAC",
          "t2": "Heat recovery (HRV)",
          "t3": "Adiabatic cooling",
          "t4": "Local exhaust ventilation"
        },
        "vysledek": "Temperatures at workstations dropped by approximately 8 °C during summer peaks. Heat recovery returns heat in winter, so hall heating costs did not increase."
      },
      "depozitar-galerie-tabor": {
        "nazev": "HVAC for a gallery collection storage room in Tábor",
        "misto": "Tábor",
        "perex": "Collection items don't need cold — they need stability. Humidity must be maintained within a narrow band year-round.",
        "zadani": "The gallery needed to maintain both temperature and relative humidity within the prescribed range in the new storage room and have a verifiable record of the conditions.",
        "rozsah": {
          "r1": "HVAC design with precise humidity control",
          "r2": "Installation of a unit with humidification and dehumidification",
          "r3": "Temperature and humidity sensors in individual storage sections",
          "r4": "Data logging and alarms to BMS with dispatch to the monitoring center",
          "r5": "Maintenance contract with regular inspections"
        },
        "technologie": {
          "t1": "HVAC with humidification",
          "t2": "Precision control (BMS)",
          "t3": "Data logging and alarms",
          "t4": "Filtration"
        },
        "vysledek": "The storage room maintains humidity within the prescribed band, the gallery has a continuous record for insurance and loan purposes, and the monitoring center alerts on deviations before anyone notices them in the morning."
      },
      "obchodni-centrum-budejovice": {
        "nazev": "EAC filters in a shopping center in České Budějovice",
        "misto": "České Budějovice",
        "perex": "Replacement of conventional filters with electronic air cleaners in air handling units. Lower pressure drop, less waste.",
        "zadani": "The facility manager was dealing with rising HVAC operating costs and repeated filter cartridge replacements across multiple units.",
        "rozsah": {
          "r1": "Assessment of existing AHUs and pressure conditions",
          "r2": "Supply and installation of Honeywell F58G and F58H EAC filters",
          "r3": "Integration of output relays and indication into the center's BMS",
          "r4": "Training of facility technicians on collector cleaning",
          "r5": "Maintenance plan with regular rinsing in a tray"
        },
        "technologie": {
          "t1": "Honeywell EAC",
          "t2": "BMS monitoring",
          "t3": "Washable collectors",
          "t4": "PM2.5 filtration"
        },
        "vysledek": "Regular filter cartridge replacement and the associated waste were eliminated. The reduced pressure drop was reflected in lower fan power consumption; the facility manager expects a payback period of two years."
      },
      "zakladni-skola-pribram": {
        "nazev": "Heat pumps and heat recovery for a primary school in Příbram",
        "misto": "Příbram",
        "perex": "The school replaced its gas boiler room with heat pumps and gained demand-controlled classroom ventilation. We handled the grant application on behalf of the school authority.",
        "zadani": "The school authority wanted to reduce building operating costs while also addressing stuffy classrooms that teachers had been complaining about for a long time.",
        "rozsah": {
          "r1": "Design and documentation for the grant application",
          "r2": "Cascade of air-to-water heat pumps as the primary heat source",
          "r3": "Heat recovery units in classrooms with CO₂-based control",
          "r4": "Renovation of distribution piping and hydraulic balancing",
          "r5": "Grant application processing under full authorization and training of the school caretaker"
        },
        "technologie": {
          "t1": "Air-to-water heat pumps",
          "t2": "Heat recovery (HRV)",
          "t3": "CO₂-based control",
          "t4": "BMS"
        },
        "vysledek": "Heating costs decreased significantly compared to the gas boiler, and classrooms have fresh air without opening windows in winter. The school passed the inspection of operated systems with no deficiencies found."
      },
      "hotel-na-sumave": {
        "nazev": "Heat pumps and air conditioning for a hotel in the Šumava region",
        "misto": "Plzeň Region",
        "perex": "A mountain hotel where heating is needed eight months a year and rooms under the roof require cooling in summer. Everything had to be as quiet as possible.",
        "zadani": "The hotel needed to replace an aging heat source, add cooling to the attic rooms, and avoid disrupting the season.",
        "rozsah": {
          "r1": "Site survey, heat loss and gain calculations, solution variants",
          "r2": "Heat pump cascade with a bivalent source for freezing days",
          "r3": "Air conditioning for attic rooms with quiet indoor units",
          "r4": "Domestic hot water heating and connection to existing storage",
          "r5": "Implementation outside the main season in two phases"
        },
        "technologie": {
          "t1": "Heat pump cascade",
          "t2": "Bivalent source",
          "t3": "Quiet indoor units",
          "t4": "DHW heating"
        },
        "vysledek": "The hotel now heats at lower costs, the attic rooms can be occupied for the first time in summer without complaints, and the entire project was completed between seasons."
      }
    }
  },
  "onas": {
    "stitek": "About Us",
    "titulek": "A team of technicians, not a sales agency",
    "lead": "We are a company operating in the field of building services engineering. We provide complete solutions from design through implementation to service — and we do most of the work with our own people.",
    "pribeh": {
      "titulek": "Who we are",
      "p1": "We are a team of experienced employees, many of whom have over 25 years of practice in the building services industry. We rely on both this experience and new insights from a field that continues to evolve dynamically.",
      "p2": "We operate from Prague and from our facility in Milevsko. Our main clients are companies and operators of office buildings, shopping centers, hospitals, museums, galleries, and public facilities — but we also install air conditioning in a family home when it makes sense.",
      "p3": "What we enjoy most: when a demanding client's clear vision meets the skill of our technicians."
    },
    "hodnoty": {
      "titulek": "What we build on",
      "polozky": {
        "h1": {
          "titulek": "Sustainability is not a slogan",
          "popis": "Before we propose a replacement, we calculate a retrofit. Keeping what works is cheaper for you and for the environment."
        },
        "h2": {
          "titulek": "In-house technicians",
          "popis": "Core employees with certified tools that we continuously train. Not a group of subcontractors you see for the first time."
        },
        "h3": {
          "titulek": "Single responsibility",
          "popis": "Design, implementation, and service under one roof. When there's a problem, nobody points at the neighbor."
        },
        "h4": {
          "titulek": "Clarity",
          "popis": "We explain abbreviations, hand over protocols, and train operators. A website where nobody understands anything is useless."
        }
      }
    },
    "divize": {
      "titulek": "Three divisions, one team",
      "polozky": {
        "d1": {
          "titulek": "Design",
          "popis": "Designers who also go on site. All levels of documentation, in BIM if needed."
        },
        "d2": {
          "titulek": "Implementation",
          "popis": "Supply and installation of HVAC, cooling, heating, plumbing, and gas. Including construction supervision."
        },
        "d3": {
          "titulek": "Service",
          "popis": "Several technician teams, 24/7 dispatch, inspections, diagnostics, and an energy specialist."
        }
      }
    },
    "odznak": {
      "titulek": "Reliable Company 2026",
      "popis": "Award for proven history, reliability, and debt-free status."
    },
    "tym": {
      "titulek": "The people you'll be talking to",
      "lead": "No anonymous email inbox. Here's the entire team with direct numbers."
    }
  },
  "novinky": {
    "stranka": {
      "stitek": "News",
      "titulek": "What's new with us",
      "lead": "Projects worth mentioning, legislative changes, training, and recruitment."
    },
    "polozky": {
      "napsali-o-nas": {
        "nazev": "Written about us: interview for Eko-Adepto",
        "perex": "The independent Eko-Adepto project visited us in person and wrote up what we told them about the company, technologies, and service.",
        "text": "Representatives of the Eko-Adepto project visited us in person and went through the offered technologies, company operations, service, and team experience with us. The article covers what we truly focus on: building services for larger buildings — offices, shopping centers, hospitals, museums, and galleries, as well as public facilities. Households make up a smaller portion of our projects, but we also do air conditioning, heat pumps, and heat recovery for them."
      },
      "klimatizace-bungalovu": {
        "nazev": "Air conditioning for a family bungalow without a single visible trunking",
        "perex": "The client wanted designer indoor units and a clean interior without visible trunking for refrigerant piping. Three site visits and grooves cut into the masonry solved it.",
        "text": "After the quote was approved, the team went on site and precisely marked the routes for grooves in the masonry. On the second visit, we ran the piping, cabling, and condensate drainage into the prepared grooves and routed them through the attic to the outdoor unit location — it was a multisplit system with three indoor and one outdoor unit. The client then had the grooves filled and painted by a mason. On the third visit, we installed the units, commissioned the system, tested it, and explained the complete operation including the phone app."
      },
      "kontrola-38-2022": {
        "nazev": "Have you had your mandatory inspection under Decree 38/2022 Coll.?",
        "perex": "Under the update effective 1 January 2023, the owner must have an inspection of operating systems carried out once every 5 years. The fine for non-compliance can reach up to 200,000 CZK.",
        "text": "The obligation applies to facilities with heat sources exceeding 70 kW, including those located outside buildings. Inspections of operating systems — air handling, heating, cooling, and cogeneration units — may only be performed by a certified energy specialist and are recorded in the ENEX database managed by the Ministry of Industry and Trade. We will arrange this for you, including related diagnostics, system balancing per Decree No. 193/2007 Coll., and pressure vessel inspections."
      },
      "nabor-techniku": {
        "nazev": "We are hiring HVAC service technicians",
        "perex": "We are expanding our service division. We are looking for technicians with an interest in air handling, cooling, or heating — experience is welcome, willingness to learn is equally valued.",
        "text": "We offer a dedicated service vehicle, complete certified equipment, ongoing manufacturer training, and teamwork where you always have someone to ask. We work primarily in pairs across Prague, Central Bohemia, and South Bohemia. Reach out via our Careers page or contact the service department manager directly."
      },
      "firemni-den-systemair": {
        "nazev": "Systemair company day in České Budějovice",
        "perex": "As part of our employee product training programme, we attended a company day hosted by Systemair.",
        "text": "We thank our partners at Systemair for sharing new industry insights and for the enjoyable leisure portion of the programme. We take product training for our technicians seriously — on site, it shows who truly knows the equipment."
      },
      "panelova-diskuze-cvut": {
        "nazev": "Panel discussion on heat pumps at CTU",
        "perex": "We participated in a panel discussion on heat pumps at the Czech Technical University in Prague.",
        "text": "The discussion centred on the real-world efficiency of heat pumps in our climate, the design of bivalent heat sources, and how design assumptions differ from actual operation. These are precisely the gaps we encounter on site, and we are happy to discuss them with the professional community."
      },
      "rozsireni-servisu": {
        "nazev": "Expansion of service department offerings",
        "perex": "The service division has added an energy specialist, system diagnostics, and heat exchanger repairs performed in-house.",
        "text": "We can now provide you with Energy Performance Certificates (EPC) and energy assessments, technical reports on operating system inspections, balancing of heating and cooling systems including protocols and indoor air quality measurements. We have also added repair and refurbishment of damaged or cracked heat exchangers — with diagnostics, repair, and testing in water baths or helium pressure testing."
      }
    }
  },
