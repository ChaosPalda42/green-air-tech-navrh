      "energetika": {
        "nazev": "EPC, audits, and refits",
        "kratky": "Energy performance certificates, energy audits, mandatory inspections per Decree 38/2022 Coll., and refits.",
        "titulek": "EPC, energy audits, and refits",
        "lead": "We value your energy. We measure, calculate, and tell you what is worth changing — and what is not.",
        "popis": "Our energy specialist prepares the EPC and energy audit, performs mandatory inspections of operating systems, and proposes a refit that does not start with demolishing the plant room.",
        "body": {
          "b1": "Preparation of EPC in compliance with the Energy Act; registered in the ENEX database (Ministry of Industry and Trade)",
          "b2": "Inspection of operating systems per Decree 38/2022 Coll. for heat sources above 70 kW",
          "b3": "Energy audit per Act No. 406/2000 Coll. and Decree No. 480/2012 Coll., always with at least two variants",
          "b4": "Energy assessments",
          "b5": "Diagnostics of heating systems, cooling systems, and ventilation",
          "b6": "System balancing per Decree 193/2007 Coll. including a protocol on flow settings",
          "b7": "Inspections of pressure vessels and gas appliances",
          "b8": "Indoor environment quality measurement — thermal comfort, CO₂, TVOC"
        },
        "upozorneni": {
          "titulek": "Mandatory inspection reminder",
          "popis": "Per the update effective 1 January 2023, the owner is required to have an energy specialist perform an inspection of operating systems once every 5 years. Non-compliance carries a fine of up to CZK 200,000."
        },
        "refit": {
          "titulek": "Refit instead of replacement",
          "popis": "Our philosophy is sustainability. After the audit, we propose which parts of the system can be retained and which should be replaced with new, more efficient components compliant with current standards. The result is a lower investment and a smaller environmental impact."
        },
        "kroky": {
          "k1": {
            "titulek": "Data collection",
            "popis": "We review the building, meter readings, documentation, and actual operation — not just design values."
          },
          "k2": {
            "titulek": "Calculation and variants",
            "popis": "We assess the existing energy performance and propose at least two optimization variants."
          },
          "k3": {
            "titulek": "Recommendation",
            "popis": "We evaluate the variants economically and environmentally and recommend the most suitable one — with justification."
          },
          "k4": {
            "titulek": "Implementation and verification",
            "popis": "We can also implement the measures and, after an agreed period, verify that the savings have actually materialized."
          }
        }
      },
      "klimatizace": {
        "nazev": "Air conditioning and heat pumps",
        "kratky": "Design, installation, subsidy processing, and service for air conditioning and heat pumps.",
        "titulek": "Air conditioning and heat pumps",
        "lead": "From site inspection through subsidy processing to operator training. For businesses, public buildings, and residential homes.",
        "popis": "You can choose from a wide range of suppliers and we will respect your preferences. We are happy to advise — we have extensive experience and know that it is not just about the purchase price.",
        "body": {
          "b1": "Site inspection and measurement",
          "b2": "Customized price and technical proposal tailored to the building",
          "b3": "Design documentation as a basis for a subsidy application",
          "b4": "Installation typically 1–3 working days",
          "b5": "Parameter setting, commissioning, and operator training",
          "b6": "Subsidy processing based on a power of attorney",
          "b7": "Warranty and post-warranty service; extended warranty available with selected suppliers",
          "b8": "24/7 service dispatch center"
        },
        "kroky": {
          "k1": {
            "titulek": "Inspection",
            "popis": "A technician visits, measures everything needed, and discusses your expectations for cooling and heating. We borrow any available building documentation."
          },
          "k2": {
            "titulek": "Proposal and design",
            "popis": "We prepare a price and technical proposal, and if needed, design documentation as a basis for a subsidy."
          },
          "k3": {
            "titulek": "Installation",
            "popis": "We agree on a schedule based on confirmed deliveries, inform you of the required construction readiness — or arrange it ourselves."
          },
          "k4": {
            "titulek": "Operation and service",
            "popis": "We start up the system, fine-tune it, train the operating staff, and sign the handover protocol. After that, we take over the service."
          }
        }
      },
      "eac-filtry": {
        "nazev": "Honeywell EAC Filters",
        "kratky": "Electronic air cleaners with a 15-year lifespan. We are the partner for the Czech Republic.",
        "titulek": "Honeywell EAC Filters",
        "lead": "We are Honeywell's partner for the Czech Republic in the field of specialized EAC filters. They capture fine dust while reducing HVAC energy consumption.",
        "popis": "The electronic air cleaner captures harmful PM2.5 particles while having a significantly lower pressure drop than a standard filter. The fan doesn't have to work as hard — and that shows up on the energy bill.",
        "body": {
          "b1": "Pre-filter for larger particles and collector plates for particles 0.3–3 micrometers",
          "b2": "Lower pressure drop than a standard filter — approximately 5 % fan power savings on the AHU",
          "b3": "Estimated payback period of around 1.5 years",
          "b4": "Washable pre-filter and collector — lower operating costs, more environmentally friendly",
          "b5": "Filter lifespan of 15 years",
          "b6": "Operates only when the fans are running",
          "b7": "Output relay for EAC status monitoring via BMS",
          "b8": "Interlock switch to prevent damage and risk when the grille is opened",
          "b9": "LED indicators for ON/OFF status, alarm, and cleaning requirement",
          "b10": "Interconnectable F58G and F58H models for flexible installation"
        },
        "servis": {
          "titulek": "EAC Filter Service",
          "popis": "In addition to warranty service, we also provide post-warranty service. Cleaning is performed by rinsing in a tray, and our dispatch center operates 24/7."
        }
      },
      "vymeniky": {
        "nazev": "Heat Exchanger Repairs",
        "kratky": "Diagnosis, repair, and pressure testing of damaged heat exchangers at our workshop.",
        "titulek": "Heat Exchanger Repairs and Overhauls",
        "lead": "A cracked heat exchanger doesn't necessarily mean a new heat exchanger. We diagnose, repair, and test — often at a fraction of the replacement cost.",
        "popis": "We have our own workshop with tanks and a helium leak test, so we can detect even a leak that a water pressure test would miss.",
        "body": {
          "b1": "Diagnosis of the damaged heat exchanger directly at the operating site",
          "b2": "Dismantling and transport to our workshop for pressure diagnostics",
          "b3": "Repair or replacement of individual heat exchanger components",
          "b4": "Water pressurization or more precise helium pressure testing",
          "b5": "Reinstallation into the equipment and operational testing",
          "b6": "Follow-up inspection during regular service checks"
        }
      }
