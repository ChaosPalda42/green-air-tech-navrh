  "slovnik": {
    "stranka": {
      "stitek": "Glossary",
      "titulek": "Building Services Abbreviations Glossary",
      "lead": "In our industry, abbreviations are used sparingly by few. Here they are explained — and wherever you encounter one on the website, simply hover over or tap it.",
      "hledat": "Search for an abbreviation or term",
      "nenalezeno": "We don't have this abbreviation yet. Contact us."
    },
    "terminy": {
      "TZB": {
        "full": "building services",
        "popis": "A collective term for ventilation, heating, cooling, plumbing and sanitary installations, gas systems, and measurement and control — essentially everything in a building that distributes heat, cooling, air, and water."
      },
      "VZT": {
        "full": "air handling",
        "popis": "A system that supplies fresh air to a building, exhausts stale air, and filters, heats, or cools it along the way."
      },
      "ZTI": {
        "full": "plumbing and sanitary installations",
        "popis": "Water supply, drainage, and sanitary fixtures within a building."
      },
      "MaR": {
        "full": "measurement and regulation",
        "popis": "Sensors, controllers, and a control system that maintain set values — temperature, humidity, flow rate — without human intervention."
      },
      "BMS": {
        "full": "building management system",
        "popis": "A supervisory system for the entire building. It collects data from all technologies, monitors alarms, and enables operations to be managed from a single location."
      },
      "PENB": {
        "full": "building energy performance certificate",
        "popis": "A mandatory document assessing a building's energy performance. It is prepared by a certified energy specialist and registered in the ENEX database."
      },
      "ENEX": {
        "full": "energy documents database",
        "popis": "A registry of energy certificates, audits, and assessments managed by the Ministry of Industry and Trade."
      },
      "MPO": {
        "full": "Ministry of Industry and Trade",
        "popis": "The central authority overseeing energy legislation and the ENEX database."
      },
      "BIM": {
        "full": "building information model",
        "popis": "A design approach where you model actual elements with properties instead of drawing lines. The model can then be used to extract schedules, clash detection results, and facility management data."
      },
      "TČ": {
        "full": "heat pump",
        "popis": "A device that transfers heat from outdoor air, ground, or water into the heating system. For every kilowatt-hour of electricity consumed, it delivers several kilowatt-hours of heat."
      },
      "EAC": {
        "full": "electronic air cleaner",
        "popis": "A filter that charges dust particles and captures them on collector plates. Compared to a conventional filter insert, it has lower pressure drop and can be washed."
      },
      "AHU": {
        "full": "air handling unit",
        "popis": "The mechanical heart of air handling: fans, filters, heat exchangers, and heat recovery in a single cabinet."
      },
      "ZZT": {
        "full": "heat recovery",
        "popis": "The outgoing warm air transfers heat to the incoming fresh air — without the two airstreams mixing."
      },
      "PM2,5": {
        "full": "fine particulate matter",
        "popis": "Particles smaller than 2.5 micrometres. They penetrate deep into the lungs, which is why filtration is designed to capture them specifically."
      },
      "TVOC": {
        "full": "total volatile organic compounds",
        "popis": "A summary indicator of gaseous organic substances in indoor air — from furniture, adhesives, paints, and cleaning products. Measured when assessing indoor air quality."
      },
      "KJ": {
        "full": "cogeneration unit",
        "popis": "A device that simultaneously produces electricity and heat. Fuel utilisation is significantly higher than with electricity generation alone."
      },
      "PBŘ": {
        "full": "fire safety design",
        "popis": "A part of the documentation specifying fire resistance, escape routes, and air handling system behaviour during a fire."
      },
      "TNS": {
        "full": "pressure vessel (stable)",
        "popis": "A vessel operating under pressure for which regulations require periodic inspections — typically expansion vessels and storage tanks."
      },
      "COP": {
        "full": "coefficient of performance",
        "popis": "The ratio of heat delivered to electricity consumed at a given moment. A COP of 4 means four kilowatt-hours of heat per kilowatt-hour of electricity."
      },
      "SCOP": {
        "full": "seasonal coefficient of performance",
        "popis": "The coefficient of performance averaged over the entire heating season. It is a fairer metric for comparing heat pumps than COP."
      },
      "EER": {
        "full": "energy efficiency ratio",
        "popis": "The ratio of cooling capacity to electrical power input."
      },
      "VRF": {
        "full": "variable refrigerant flow system",
        "popis": "An air conditioning system where a single outdoor unit serves multiple indoor units, with refrigerant flow regulated according to each unit's actual demand."
      },
      "DSP": {
        "full": "building permit documentation",
        "popis": "A project stage submitted to the building authority for assessment of the construction."
      },
      "DPS": {
        "full": "construction documentation",
        "popis": "A detailed project stage used for actual installation on site."
      },
      "RDS": {
        "full": "as-built documentation",
        "popis": "Documentation prepared by the contractor for execution purposes, building on the construction documentation."
      },
      "TDS": {
        "full": "construction supervision (client's representative)",
        "popis": "A specialist safeguarding the investor's interests on site — overseeing quality, scope, and compliance with the design."
      },
      "ČSN": {
        "full": "Czech technical standard",
        "popis": "Czech national technical standard. Specifies requirements for, for example, fresh air volume, noise levels, or equipment safety."
      },
      "HVAC": {
        "full": "heating, ventilation, air conditioning",
        "popis": "English abbreviation for heating, ventilation, and air conditioning. The international equivalent of the Czech term TZB (building services engineering)."
      }
    }
  },
  "gdpr": {
    "titulek": "Data Protection",
    "lead": "Short and without legal jargon: what happens to the data you send us via the form.",
    "sekce": {
      "s1": {
        "titulek": "Who processes the data",
        "text": "The data controller is Green Air Tech s.r.o., Company ID 19667531, registered at Pobřežní 394/12, 186 00 Prague 8."
      },
      "s2": {
        "titulek": "What data and why",
        "text": "We process your name, email, phone number, and message text — solely so that we can respond to your inquiry and, if applicable, prepare a proposal."
      },
      "s3": {
        "titulek": "How long",
        "text": "Data from unresolved inquiries is deleted within two years. For completed projects, we retain it for the period required by accounting and tax regulations."
      },
      "s4": {
        "titulek": "Who we share it with",
        "text": "No one outside our company and our email and accounting service providers, who are bound by confidentiality. We do not sell data or use it for profiling."
      },
      "s5": {
        "titulek": "Your rights",
        "text": "You have the right to access your data, request correction, deletion, or object to processing. Simply write to info@greenairtech.cz."
      },
      "s6": {
        "titulek": "Cookies",
        "text": "The website uses only technical cookies necessary for its operation. We do not launch analytics or marketing tools without your consent."
      }
    },
    "poznamka": "This text is a sample; we recommend having it reviewed before the website goes live."
  },
