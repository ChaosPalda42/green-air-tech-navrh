          "r4": "Expansion of building automation and integration with the existing BMS",
          "r5": "Phased execution by floor to ensure uninterrupted operations"
        },
        "technologie": {
          "t1": "AHU with heat recovery (ERV)",
          "t2": "Chilled water system",
          "t3": "Fan coils",
