    "sluzby": {
      "stitek": "What We Do",
      "titulek": "Seven disciplines, one responsibility",
      "lead": "You don't have to piece together a designer, an installation company and a service provider. We manage the entire chain — and if something happens two years later, you still call the same number."
    },
    "postup": {
      "stitek": "How We Work",
      "titulek": "From site survey to long-term care",
      "lead": "Four steps, no surprises. At each stage you know what you get and who is responsible.",
      "kroky": {
        "obhlidka": {
          "titulek": "Site Survey and Brief",
          "popis": "We come to you, take measurements, review technical documentation and listen to what you actually need. Missing documentation can be arranged by us upon agreement."
        },
        "navrh": {
          "titulek": "Design and Quotation",
          "popis": "We prepare the technical solution, budget and schedule. For larger systems we produce all stages of project documentation, in BIM if required."
        },
        "realizace": {
          "titulek": "Implementation and Handover",
          "popis": "We supply and install, coordinate interfaces with other trades, and provide design and technical supervision. At the end we train the operators and hand over documentation."
        },
        "servis": {
          "titulek": "Service and Savings",
          "popis": "We take over regular maintenance, inspections and checks. After the agreed period we verify that the system delivers the promised savings."
        }
      }
    },
    "realizace": {
      "stitek": "Selected Projects",
      "titulek": "Where our air is already circulating",
      "lead": "Offices, healthcare, manufacturing and schools. See what we specifically solved on site."
    },
    "duvody": {
      "stitek": "Why Choose Us",
      "titulek": "Three things we care about",
      "polozky": {
        "udrzitelnost": {
          "titulek": "Retrofit first, replace only if necessary",
          "popis": "The cheapest kilowatt-hour is the one you don't consume. After an audit, we'll tell you what makes sense to keep from the existing system and what actually needs replacing. Not every project has to start with demolishing the plant room."
        },
        "jedenTym": {
          "titulek": "Designer and service technician at the same table",
          "popis": "Colleagues from the service division walk the site alongside the implementation team. They get to know the building before they take it over — and that shows in the speed of the first intervention."
        },
        "dispecink": {
          "titulek": "A control desk that picks up the phone",
          "popis": "A 24/7 hotline all year round. If you can't get through immediately, leave a message — it reaches us instantly by email and we call you back."
        }
      }
    },
    "slovnik": {
      "stitek": "We speak technically, but clearly",
      "titulek": "An abbreviation you don't understand? Hover over it.",
      "lead": "In our industry there are more abbreviations than screws. Anywhere on the site you come across an underlined abbreviation, simply hover over it with your mouse or tap it on mobile — we'll explain it.",
      "ukazka": "We prepare energy performance certificates, design HVAC and controls systems, and integrate them into a BMS.",
      "cta": "Open the abbreviation glossary"
    },
    "kontakt": {
      "stitek": "Get in touch",
      "titulek": "Tell us what you're dealing with",
      "lead": "A few sentences are enough. We typically respond within one business day — and if it's a breakdown, call the control desk directly."
    }
