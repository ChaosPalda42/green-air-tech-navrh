# Green Air Tech — pravidla pro Apache (Debian 13, mod_rewrite + mod_headers)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Nahrané fotky se nikdy nesmí spustit jako skript. Musí to stát PŘED
  # zkratkou na existující soubory — ta končí [L] a tohle by se za ní
  # nikdy nevyhodnotilo. (Navíc je to v media/.htaccess, kdyby se přepisy
  # adres nečetly.)
  RewriteRule ^media/.*\.(php[0-9s]?|phtml|phar|pht|html?|cgi|pl|py|sh)$ - [F,L]

  # existující soubor (CSS, obrázky, fonty) obslouží Apache sám
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # všechno ostatní jde do PHP
  RewriteRule ^ index.php [L]
</IfModule>

# vlastní stránka 404 i pro případ, že by se PHP nespustilo
ErrorDocument 404 /index.php

<IfModule mod_headers.c>
  # Bezpečnostní hlavičky stránek posílá PHP (App\Jadro\Hlavicky) — platí pak
  # i na nginxu, kde se tenhle soubor vůbec nečte, a nejdou dvakrát. Tady se
  # ošetří jen soubory, které Apache posílá bez PHP: CSS, skripty, fonty,
  # obrázky a nahrané fotky. Jména aktiv nesou hash obsahu, proto natrvalo.
  <FilesMatch "\.(css|js|mjs|woff2?|png|jpe?g|webp|avif|svg|ico|map)$">
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

Options -Indexes
