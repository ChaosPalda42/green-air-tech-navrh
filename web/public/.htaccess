# Green Air Tech — pravidla pro Apache (Debian 13, mod_rewrite + mod_headers)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Nahrané fotky se nikdy nesmí spustit jako skript. Musí to stát PŘED
  # zkratkou na existující soubory — ta končí [L] a tohle by se za ní
  # nikdy nevyhodnotilo. (Navíc je to v media/.htaccess, kdyby se přepisy
  # adres nečetly.)
  RewriteRule ^media/.*\.(php[0-9s]?|phtml|phar|pht|html?|cgi|pl|py|sh)$ - [F,L]

  # Ověření certifikátu (ACME) musí projít i po čistém HTTP, jinak by se
  # obnova certifikátu zacyklila na našem vlastním přesměrování níž.
  RewriteRule ^\.well-known/ - [L]

  # Jedna adresa pro celý web: https://www.greenairtech.cz. Bez tohohle
  # bloku web odpovídal na čtyřech adresách (http i https, s www i bez) a
  # žádná z nich na druhou neukazovala — vyhledávač je indexoval jako čtyři
  # weby a sílu odkazů si mezi ně rozdělil. Kanonická adresa v hlavě
  # stránky je jen žádost; tohle je odpověď serveru.
  #
  # Obě podmínky jmenují jen tyhle dva hostitele, takže vývoj na localhostu,
  # přístup přes IP ani případná testovací adresa se nepřesměrují. Když se
  # web přestěhuje na jinou doménu, mění se tyhle dva řádky.
  #
  # „Už jsme na HTTPS" se poznává stejně jako v PHP (App\Jadro\Hlavicky):
  # buď mod_ssl, nebo hlavička od předřazené proxy. Jinak by web za proxy,
  # která HTTPS ukončuje u sebe, přesměrovával do nekonečna.
  RewriteCond %{HTTP_HOST} ^(www\.)?greenairtech\.cz$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.greenairtech.cz%{REQUEST_URI} [R=301,L,QSA]

  RewriteCond %{HTTP_HOST} ^greenairtech\.cz$ [NC]
  RewriteRule ^ https://www.greenairtech.cz%{REQUEST_URI} [R=301,L,QSA]

  # existující soubor (CSS, obrázky, fonty) obslouží Apache sám
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # všechno ostatní jde do PHP
  RewriteRule ^ index.php [L]
</IfModule>

# vlastní stránka 404 i pro případ, že by se PHP nespustilo
ErrorDocument 404 /index.php

<IfModule mod_headers.c>
  # Bezpečnostní hlavičky stránek posílá PHP (App\Jadro\Hlavicky) — platí pak
  # i na nginxu, kde se tenhle soubor vůbec nečte, a nejdou dvakrát. Tady se
  # ošetří jen soubory, které Apache posílá bez PHP: CSS, skripty, fonty,
  # obrázky a nahrané fotky. Jména aktiv nesou hash obsahu, proto natrvalo.
  <FilesMatch "\.(css|js|mjs|woff2?|png|jpe?g|webp|avif|svg|ico|map)$">
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

Options -Indexes
